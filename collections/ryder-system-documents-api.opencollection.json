{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ryder Carrier Documents API",
    "version": "2026-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ryder.com/rcsc/events/v1/documents",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "load_id",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "document_type",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a document (e.g., Bill of Lading, Proof of Delivery) to the RyderShare platform associated with a specific load."
        }
      ]
    }
  ],
  "bundled": true
}